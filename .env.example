# =========================================================
# qeb-diff-back - configuracion
# =========================================================
#
# Copia este archivo a .env y llena los valores.

# Puerto donde escucha el back
PORT=3100

# Usuarios del dashboard. Formato: user1:password1,user2:password2
# Ej: AUTH_USERS=akary:abc123,jos:xyz456,mario:def789,antonio:ghi012
AUTH_USERS=

# Secret para firmar los tokens de session (HMAC).
# Minimo 16 caracteres. Rotarlo invalida todas las sesiones activas.
# Generalo con: openssl rand -hex 32
AUTH_SECRET=

# Origenes permitidos por CORS, separados por coma.
# Ej: https://qeb-diff.vercel.app,https://diff.qeb.mx
# Dejar vacio para permitir cualquier origen (solo util en dev local).
CORS_ORIGIN=

# Asana Personal Access Token (Nivel 2 - lookup de titulo de tareas).
# Creado en https://app.asana.com/0/my-apps. Requiere lectura al workspace QEB.
# Si queda vacio: los chips siguen apareciendo con el GID, pero sin titulo.
ASANA_TOKEN=

# Paths ABSOLUTOS a los repos locales de QEB (para listar commits sin clonar nada mas).
# En el VPS apunta a donde hayas clonado back-qeb y front-qeb.
FRONT_REPO_PATH=
BACK_REPO_PATH=

# Si true, el back corre `git fetch --all --prune` cada minuto por repo.
AUTO_FETCH=true

# ===== BDs (solo lectura; nunca se escribe) =====

# main (prod)
MAIN_HOST=
MAIN_PORT=25060
MAIN_USER=
MAIN_PASSWORD=
MAIN_DB=
MAIN_SSL=true

# dev
DEV_HOST=
DEV_PORT=25060
DEV_USER=
DEV_PASSWORD=
DEV_DB=
DEV_SSL=true

# release
RELEASE_HOST=
RELEASE_PORT=3306
RELEASE_USER=
RELEASE_PASSWORD=
RELEASE_DB=
RELEASE_SSL=false

# stage
STAGE_HOST=
STAGE_PORT=3306
STAGE_USER=
STAGE_PASSWORD=
STAGE_DB=
STAGE_SSL=false
