# =========================================================
# qeb-diff-back - configuracion
# =========================================================
#
# Copia este archivo a .env y llena los valores.

# Puerto donde escucha el back
PORT=3100

# Password compartida para acceder al dashboard.
# Cambiar antes de desplegar. Todos los devs del equipo usan la misma.
AUTH_PASSWORD=

# Origenes permitidos por CORS, separados por coma.
# Ej: https://qeb-diff.vercel.app,https://diff.qeb.mx
# Dejar vacio para permitir cualquier origen (solo util en dev local).
CORS_ORIGIN=

# Asana Personal Access Token (Nivel 2 - lookup de titulo de tareas).
# Creado en https://app.asana.com/0/my-apps. Requiere lectura al workspace QEB.
# Si queda vacio: los chips siguen apareciendo con el GID, pero sin titulo.
ASANA_TOKEN=

# Paths ABSOLUTOS a los repos locales de QEB (para listar commits sin clonar nada mas).
# En el VPS apunta a donde hayas clonado back-qeb y front-qeb.
FRONT_REPO_PATH=
BACK_REPO_PATH=

# Si true, el back corre `git fetch --all --prune` cada minuto por repo.
AUTO_FETCH=true

# ===== BDs (solo lectura; nunca se escribe) =====

# main (prod)
MAIN_HOST=
MAIN_PORT=25060
MAIN_USER=
MAIN_PASSWORD=
MAIN_DB=
MAIN_SSL=true

# dev
DEV_HOST=
DEV_PORT=25060
DEV_USER=
DEV_PASSWORD=
DEV_DB=
DEV_SSL=true

# release
RELEASE_HOST=
RELEASE_PORT=3306
RELEASE_USER=
RELEASE_PASSWORD=
RELEASE_DB=
RELEASE_SSL=false

# stage
STAGE_HOST=
STAGE_PORT=3306
STAGE_USER=
STAGE_PASSWORD=
STAGE_DB=
STAGE_SSL=false

# ===== Logs (tab Logs del dashboard) =====
# Lista ordenada de fuentes de logs. Cada item: key:tipo:arg (separados por coma).
#   key:pm2:<nombreProcesoPm2>  -> el back corre `pm2 logs <nombre> --raw --nostream`
#   key:do                      -> DigitalOcean App Platform (usa DO_* de abajo)
# El `key` es la etiqueta que se ve en la pestaña. Orden = orden de las pestanas.
# Si queda vacio, la pestana Logs dice "sin fuentes configuradas".
# Ej: release:pm2:qeb-back-release,stage:pm2:qeb-back-stage,diff:pm2:qeb-diff-back,monitoreo:pm2:monitoreo-qeb-back,bi:pm2:bi-back
# (para prod en DO, agrega un item tipo `main:do` y llena DO_* abajo)
LOGS_SOURCES=

# Solo si usas una fuente `:do` (p.ej. prod en DigitalOcean App Platform).
# DO_APP_ID: UUID de la app (console.digitalocean.com → Apps → ID en la URL).
# DO_COMPONENT: nombre del componente de servicio (p.ej. "api" o "qeb-back").
# DO_TOKEN: PAT con scope read de apps. Crear en API → Tokens.
DO_APP_ID=
DO_COMPONENT=
DO_TOKEN=
